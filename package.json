{
  "name": "tamdok",
  "main": "expo-router/entry",
  "version": "0.1",
  "scripts": {
    "start": "expo start --dev-client --lan",
    "dev": "expo start --dev-client --lan",
    "build": "eas build --platform ios --profile production --local --output ./build.ipa",
    "testflight": "eas submit --platform ios --path ./build.ipa",
    "deploy": "pnpm build && pnpm testflight && sudo rm ./build.ipa",
    "ios": "node scripts/sync-ios-icon.mjs && expo run:ios --device",
    "ios:install": "node scripts/sync-ios-icon.mjs && expo run:ios --device --no-bundler",
    "android-build": "eas build --platform android --profile preview --local --output ./tamdok.apk",
    "android": "npx expo run:android --device",
    "web": "expo start --web",
    "update": "pnpm install expo@latest && npx expo install --fix && npx expo-doctor && npx expo prebuild --clean",
    "build:source": "node scripts/build-bundled-source.mjs",
    "build:wasm-host": "node scripts/build-wasm-host.mjs",
    "lint": "expo lint"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.40.0",
    "@dr.pogodin/react-native-static-server": "^0.28.0",
    "@expo/ui": "~57.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@oleg_svetlichnyi/expo-icloud-storage": "^1.1.3",
    "@react-native-community/slider": "5.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@variegated-coffee/serde-postcard-ts": "^0.1.4",
    "babel-preset-expo": "^57.0.0",
    "expo": "~57.0.14",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.12",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-ios-scene-lifecycle-plugin": "github:YesterdaysLemon/expo-ios-scene-lifecycle-plugin",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-mail-composer": "~57.0.1",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-text-extractor": "^2.0.0",
    "expo-web-browser": "~57.0.2",
    "fflate": "^0.8.3",
    "flow-enums-runtime": "^0.0.6",
    "linkedom": "^0.18.13",
    "memoize-one": "^6.0.0",
    "node-html-parser": "^9.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "~13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
