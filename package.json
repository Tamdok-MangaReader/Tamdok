{
  "name": "tamdok",
  "main": "expo-router/entry",
  "version": "1.3",
  "scripts": {
    "run:expo": "expo start --dev-client --lan",
    "run:ios": "node scripts/sync-ios-icon.mjs && expo run:ios --device",
    "run:android": "npx expo run:android --device",
    "run:web": "expo start --web",
    "build:ios": "eas build --platform ios --profile production --local --output ./build.ipa",
    "build:android": "eas build --platform android --profile preview --local --output ./tamdok.apk",
    "build:wasm-host": "node scripts/build-wasm-host.mjs",
    "deploy:testflight": "eas submit --platform ios --path ./build.ipa",
    "deploy:ios": "npm build && npm testflight && sudo rm ./build.ipa",
    "install:ios": "node scripts/sync-ios-icon.mjs && expo run:ios --device --no-bundler",
    "expo:update": "npm install expo@latest && npx expo install --fix && npx expo-doctor && npx expo prebuild --clean",
    "expo:lint": "expo lint",
    "expo:doctor": "npx expo-doctor",
    "lint": "expo lint"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.41.0",
    "@dr.pogodin/react-native-static-server": "^0.28.1",
    "@expo/ui": "~58.0.25",
    "@expo/vector-icons": "^15.1.1",
    "@oleg_svetlichnyi/expo-icloud-storage": "^1.1.3",
    "@react-native-community/slider": "5.2.1",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@react-navigation/elements": "^2.9.45",
    "@variegated-coffee/serde-postcard-ts": "^0.1.4",
    "babel-preset-expo": "^58.0.20",
    "expo": "~58.0.21",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-auth-session": "~58.0.16",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-device-hub": "^0.18.0",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-mail-composer": "~58.0.3",
    "expo-media-library": "~58.0.13",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-text-extractor": "^2.0.0",
    "expo-web-browser": "~58.0.7",
    "fflate": "^0.8.3",
    "flow-enums-runtime": "^0.0.6",
    "linkedom": "^0.18.14",
    "memoize-one": "^6.0.0",
    "node-html-parser": "^9.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-cookies/cookies",
          "expo-text-extractor",
          "library-live-activity",
          "expo-device-hub"
        ]
      }
    }
  },
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
