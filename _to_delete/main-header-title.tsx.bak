import { Stack } from "expo-router";

import { ThemedText } from "@/components/ui/themed-text";

export function MainHeaderTitle({ children }: { children: string }) {
  return (
    <>
      <Stack.Screen
        options={{
          title: children,
          headerLargeTitle: false,
          headerTitle: () => null,
        }}
      />
      <Stack.Toolbar placement="left">
        <Stack.Toolbar.View hidesSharedBackground>
          <ThemedText variant="title1" style={{ fontWeight: "700" }}>
            {children}
          </ThemedText>
        </Stack.Toolbar.View>
      </Stack.Toolbar>
    </>
  );
}
