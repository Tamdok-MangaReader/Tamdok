{
  "expo": {
    "name": "Tamdok",
    "slug": "tamdok",
    "version": "1.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tamdok",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/tamdok.icon",
      "bundleIdentifier": "com.solsticeleaf.Tamdok",
      "appleTeamId": "KMUQN5QBHJ",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "UIViewControllerBasedStatusBarAppearance": true,
        "CFBundleDevelopmentRegion": "en",
        "NSUserNotificationsUsageDescription": "Tamdok schedules local reminders for new chapters notification.",
        "NSContactsUsageDescription": "Tamdok uses Live Text on manga pages. Some images may contain contact information that iOS can recognize.",
        "NSLocalNetworkUsageDescription": "Tamdok connects to the development server on your local network during development.",
        "NSBonjourServices": ["_expo._tcp", "_http._tcp"],
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Tamdok data",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["public.json", "public.plain-text"]
          }
        ],
        "CFBundleLocalizations": [
          "en",
          "ru",
          "es",
          "pt",
          "fr",
          "de",
          "id",
          "ja",
          "ko"
        ]
      }
    },
    "locales": {
      "en": "./locale/ios/en.json",
      "ru": "./locale/ios/ru.json",
      "es": "./locale/ios/es.json",
      "pt": "./locale/ios/pt.json",
      "fr": "./locale/ios/fr.json",
      "de": "./locale/ios/de.json",
      "id": "./locale/ios/id.json",
      "ja": "./locale/ios/ja.json",
      "ko": "./locale/ios/ko.json"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-blank.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          },
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tamdok uses Face ID to unlock the app."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "ru", "es", "pt", "fr", "de", "id", "ja", "ko"],
            "android": ["en", "ru", "es", "pt", "fr", "de", "id", "ja", "ko"]
          }
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      "expo-mail-composer",
      "expo-sharing",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-alternate-app-icons",
